generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        String  @id @default(cuid())
  prenom    String
  nom       String
  email     String  @unique
  telephone String
  notes     String? // suivi : allergies, préférences, particularités des ongles…

  // Prospection : consentement recueilli à la réservation, révocable à tout
  // moment via le lien de désinscription (jeton non devinable).
  consentementMarketing Boolean   @default(false)
  consentementLe        DateTime?
  desabonneLe           DateTime?
  jetonDesabonnement    String    @unique @default(cuid())

  // Blocage manuel : la réservation en ligne et la commande de press-on lui
  // sont refusées. Le numéro compte autant que l'adresse — changer d'e-mail
  // ne doit pas suffire à repasser.
  bloqueeLe    DateTime?
  motifBlocage String?

  // Message de reconquête après une longue absence, envoyé une seule fois par
  // période d'absence : la date est comparée à la dernière venue.
  reconqueteEnvoyeeLe DateTime?

  // Espace cliente (facultatif) : connexion par lien envoyé par e-mail,
  // sans mot de passe à créer ni à retenir.
  codeParrainage String  @unique
  parraine       Cliente?  @relation("Parrainage", fields: [parraineParId], references: [id])
  parraineParId  String?
  filleules      Cliente[] @relation("Parrainage")

  creeLe     DateTime         @default(now())
  modifieLe  DateTime         @updatedAt
  rendezVous RendezVous[]
  envois      EnvoiCampagne[]
  jetons      JetonConnexion[]
  recompenses Recompense[]
  commandes   CommandePressOn[]
  changementsEmail ChangementEmail[]
  avantages   AvantageParrainage[]
}

// Programme « Squad ». Le palier lui-même n'est pas stocké : il se recalcule à
// partir des filleules réellement venues, ce qui évite qu'une valeur figée
// diverge de la réalité. Seuls les avantages accordés sont conservés, car ils
// se consomment.
enum TypeAvantage {
  // Barème en vigueur.
  BESTIE_HUILE // une huile à cuticule (1 filleule)
  SQUAD_REMISE // −10 % sur la prochaine prestation (3 filleules)
  ICONE_NAIL_ART // un nail art niveau 2 (5 filleules)
  DIVA_POSE_ANNUELLE // une pose offerte par année de statut Ambassadrice (10 filleules)

  // Barème précédent, conservé pour les avantages déjà accordés : une cliente
  // qui a gagné −15 % garde −15 %. Ces valeurs ne sont plus attribuées, mais
  // les supprimer réécrirait ce qui lui a été promis.
  BESTIE_REMISE // −15 % sur la prochaine prestation
  SQUAD_MANUCURE // une manucure offerte
  ICONE_CHOIX // nail art niveau 2 ou press-on, au choix
}

model AvantageParrainage {
  id        String       @id @default(cuid())
  cliente   Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  type      TypeAvantage
  // Vide pour les avantages gagnés une fois pour toutes ; l'année pour la pose
  // annuelle des Ambassadrices, qui se renouvelle tant que le statut tient.
  periode   String       @default("")
  code      String       @unique
  gagneLe   DateTime     @default(now())
  utiliseLe DateTime?

  // Un même avantage ne peut être accordé deux fois pour la même période.
  @@unique([clienteId, type, periode])
  @@index([clienteId])
}

// Changement d'adresse e-mail demandé depuis l'espace cliente. L'adresse
// servant à se connecter, la modification n'est appliquée qu'après un clic
// sur le lien envoyé à la nouvelle adresse : une faute de frappe ne peut donc
// pas enfermer la cliente dehors.
model ChangementEmail {
  id          String    @id @default(cuid())
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId   String
  nouvelEmail String
  jeton       String    @unique
  expireLe    DateTime
  utiliseLe   DateTime?
  creeLe      DateTime  @default(now())

  @@index([clienteId])
}

// Lots de la roue, entièrement gérés depuis l'espace gérante.
model LotFidelite {
  id              String  @id @default(cuid())
  libelle         String // texte complet annoncé à la gagnante
  texteSurRoue    String // version courte affichée sur le quartier
  chance          Int // poids du tirage ; la part effective est calculée sur le total
  couleur         String  @default("#f9a8d4")
  aRetirerAuSalon Boolean @default(true)
  actif           Boolean @default(true)
  ordre           Int     @default(0)

  recompenses Recompense[]
}

// Lot gagné à la roue de fidélité, présenté au salon par la cliente.
model Recompense {
  id        String      @id @default(cuid())
  cliente   Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  lot       LotFidelite @relation(fields: [lotId], references: [id])
  lotId     String
  code      String      @unique
  gagneLe   DateTime    @default(now())
  utiliseLe DateTime?

  @@index([clienteId])
}

// Lien de connexion à usage unique et à durée limitée.
model JetonConnexion {
  id        String    @id @default(cuid())
  jeton     String    @unique
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  expireLe  DateTime
  utiliseLe DateTime?
  creeLe    DateTime  @default(now())

  @@index([clienteId])
}

// Campagne de fidélisation / parrainage envoyée aux clientes consentantes.
model Campagne {
  id        String          @id @default(cuid())
  objet     String
  contenu   String // texte simple ; {{prenom}} est remplacé à l'envoi
  segment   String // voir src/lib/segments.ts
  statut    StatutCampagne  @default(BROUILLON)
  creeLe    DateTime        @default(now())
  envoyeeLe DateTime?
  envois    EnvoiCampagne[]
}

// Une ligne par destinataire : évite les doublons et garde une trace des échecs.
model EnvoiCampagne {
  id         String   @id @default(cuid())
  campagne   Campagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  campagneId String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  ok         Boolean
  erreur     String?
  envoyeLe   DateTime @default(now())

  @@unique([campagneId, clienteId])
}

enum StatutCampagne {
  BROUILLON
  EN_COURS
  ENVOYEE
}

model Prestation {
  id          String  @id @default(cuid())
  nom         String
  categorie   String // "Vernis semi-permanent", "Gainage", "Pose Gel X", "Pose Pop-it"
  description String?
  dureeMin    Int // durée indicative en minutes
  prixCents   Int // 3500 = 35,00 €
  aPartirDe   Boolean @default(false) // prix "à partir de" (nail art niveau 3…)
  active      Boolean @default(true)
  ordre       Int     @default(0)

  // Nature de l'acte et technique concernée : pilotent les règles de
  // réservation (une dépose ou un remplissage ne se proposent pas à tout le monde).
  typeActe TypeActe @default(POSE)
  typePose TypePose

  lignes LignePrestation[]
}

// Une demande peut porter plusieurs prestations : la cliente en coche autant
// qu'elle souhaite, et la dépose imposée par les règles s'y ajoute (automatique).
model LignePrestation {
  id           String     @id @default(cuid())
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  rendezVousId String
  prestation   Prestation @relation(fields: [prestationId], references: [id])
  prestationId String
  automatique  Boolean    @default(false)
  ordre        Int        @default(0)

  // Prix au moment de la demande : le catalogue évolue, l'histoire non. Nul
  // pour les demandes antérieures à ce suivi, qui retombent sur le tarif actuel.
  prixCents Int?

  @@unique([rendezVousId, prestationId])
  @@index([rendezVousId])
}

enum TypeActe {
  POSE
  REMPLISSAGE
  DEPOSE
}

enum TypePose {
  VSP
  GAINAGE
  GEL_X
  POP_IT
}

// Ce que la cliente a sur les ongles au moment de venir.
enum EtatOngles {
  NATUREL
  POSE_ZELART
  POSE_EXTERIEURE
}

// Créneaux d'ouverture récurrents : Zélia reçoit du lundi au samedi à 9h ou 14h.
// Une ligne = une fenêtre réservable (un seul rendez-vous par fenêtre).
model Disponibilite {
  id          String @id @default(cuid())
  jourSemaine Int // 1 = lundi … 7 = dimanche (ISO 8601)
  heureDebut  String // "09:00"
  heureFin    String // "12:30"

  @@index([jourSemaine])
}

// Exceptions ponctuelles : congés, jour férié, rendez-vous perso…
model Indisponibilite {
  id    String   @id @default(cuid())
  debut DateTime
  fin   DateTime
  motif String?
}

// Galerie de réalisations affichée sur la page d'accueil
model Photo {
  id      String   @id @default(cuid())
  url     String
  legende String?
  ordre   Int      @default(0)
  creeLe  DateTime @default(now())
}

model RendezVous {
  id           String           @id @default(cuid())
  cliente      Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String
  lignes       LignePrestation[]
  debut        DateTime
  fin          DateTime // figé à la réservation, indépendant des évolutions de la prestation
  statut       StatutRendezVous @default(EN_ATTENTE)
  noteCliente  String?
  inspiration  String? // envies décrites par la cliente
  creeLe       DateTime         @default(now())

  // État des ongles déclaré à la réservation, et dépose ajoutée d'office
  // lorsque les règles l'imposent (pose extérieure, ou Gel X à retirer).
  etatOngles     EtatOngles?
  typePoseActuel TypePose?

  // Case obligatoire : santé, allergies et droit de refus de la prestation
  consentementSante Boolean @default(false)

  // −15 % accordés à une filleule sur sa première prestation. Figé ici plutôt
  // que recalculé : l'offre est acquise au moment de la demande, même si la
  // situation de la cliente change ensuite.
  remiseFilleule Boolean @default(false)

  // Acompte demandé aux nouvelles clientes (cf. CGV)
  acompteDemandeLe        DateTime?
  acompteRegleLe          DateTime?
  acompteRelanceEnvoyeeLe DateTime? // relance à 24h si toujours pas réglé

  // Horodatages des envois automatiques, pour ne jamais écrire deux fois
  rappelEnvoyeLe        DateTime?
  relanceEnvoyeeLe      DateTime?
  demandeAvisEnvoyeeLe  DateTime? // invitation à laisser un avis Google, une fois la pose faite

  // Créneau proposé par la cliente faute d'horaire ouvert qui lui convienne.
  // Le rendez-vous suit le circuit habituel — il arrive « à confirmer » et
  // Zélia tranche — mais il sort de ses fenêtres d'ouverture, ce qu'elle doit
  // voir avant d'accepter.
  creneauPropose Boolean @default(false)

  // Pourcentage figé au moment de la demande, comme l'est le prix de chaque
  // ligne : le barème peut changer, ce qui a été promis à cette cliente-là ne
  // doit pas bouger sous ses yeux.
  remiseFilleulePourcent Int?

  // Mot laissé au moment de valider la venue. Distinct de la fiche technique :
  // celle-ci décrit la pose pour la reproduire, celui-ci raconte la visite —
  // ponctualité, envies exprimées, ce qu'il faudra retenir la prochaine fois.
  commentaireVisite String?

  // Fiche technique remplie par Zélia après la pose : ce qu'elle a
  // réellement fait, pour reproduire à l'identique et suivre les réactions.
  forme       String?
  longueur    String?
  produits    String? // références de gels, couleurs, marques
  noteTechnique String?
  realisations Realisation[]

  inspirations InspirationImage[]

  @@index([debut])
}

// Cliente intéressée par un jour complet : prévenue dès qu'une annulation
// libère un créneau. Pas de date précise à faire correspondre — l'annonce
// part à tout le monde, au premier arrivé de reprendre le créneau.
model ListeAttente {
  id         String    @id @default(cuid())
  prenom     String
  email      String
  telephone  String?
  note       String? // jour souhaité, prestation envisagée…
  creeLe     DateTime  @default(now())
  notifieeLe DateTime? // avertie une fois ; à elle de rejoindre la liste si besoin

  @@index([notifieeLe])
}

// Réglages modifiables par la gérante sans redéploiement (lien d'acompte…).
model Parametre {
  cle       String   @id
  valeur    String
  modifieLe DateTime @updatedAt
}

// Photos de la pose réalisée, prises par Zélia. Peuvent alimenter la galerie
// publique d'un clic.
model Realisation {
  id           String     @id @default(cuid())
  url          String
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  rendezVousId String
  publiee      Boolean    @default(false)
  creeLe       DateTime   @default(now())

  @@index([rendezVousId])
}

// Photos d'inspiration jointes par la cliente à sa demande de rendez-vous.
model InspirationImage {
  id           String     @id @default(cuid())
  url          String
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  rendezVousId String
  creeLe       DateTime   @default(now())

  @@index([rendezVousId])
}

// Catalogue des press-on : les sets sur-mesure (tarifés par niveau de nail art)
// et les collections déjà dessinées, prêtes à commander.
model ModelePressOn {
  id          String  @id @default(cuid())
  nom         String
  collection  String // "Sur-mesure", "Automne / Hiver", "Capsule Halloween", "Printemps / Été"
  description String?
  prixCents   Int
  aPartirDe   Boolean @default(false)
  // Un set sur-mesure est dessiné d'après les envies décrites par la cliente ;
  // un modèle de collection existe déjà, seules les mesures changent.
  surMesure   Boolean @default(false)
  photoUrl    String?
  actif       Boolean @default(true)
  ordre       Int     @default(0)

  commandes CommandePressOn[]
}

// Remise en main propre (ou par un proche) ou envoi postal aux frais de la
// cliente, annoncés avant validation — cf. CGV.
enum ModeRemise {
  MAIN_PROPRE
  POSTAL
}

// Les press-on étant personnalisés, le paiement intégral précède la
// fabrication : le statut suit cette chronologie.
enum StatutCommandePressOn {
  DEMANDE
  A_PAYER
  PAYEE
  EN_FABRICATION
  PRETE
  REMISE
  ANNULEE
}

model CommandePressOn {
  id        String        @id @default(cuid())
  cliente   Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  modele    ModelePressOn @relation(fields: [modeleId], references: [id])
  modeleId  String

  // Prix figé à la commande : le catalogue peut évoluer ensuite.
  prixCents      Int
  aPartirDe      Boolean @default(false)
  fraisPortCents Int? // chiffrés par Zélia pour un envoi postal

  modeRemise ModeRemise
  adresse    String? // uniquement pour l'envoi postal

  // Sur-mesure : ce que la cliente veut. Mesures : indispensables pour tailler
  // les capsules, quel que soit le modèle.
  forme       String?
  longueur    String?
  mesures     String?
  inspiration String?

  statut StatutCommandePressOn @default(DEMANDE)
  note   String? // note interne de Zélia

  // Lien de règlement propre à cette commande, au bon montant. Créé par l'API
  // SumUp quand elle est configurée, sinon collé à la main par Zélia depuis un
  // lien de paiement créé dans son application. Le lien réutilisable des
  // réglages ne peut pas servir ici : il porte le montant de l'acompte des
  // rendez-vous, pas celui du set.
  lienPaiement       String?
  montantDemandeCents Int? // ce qui a réellement été demandé, acompte ou total

  paiementDemandeLe DateTime?
  paiementRecuLe    DateTime?
  remiseLe          DateTime?

  creeLe    DateTime @default(now())
  modifieLe DateTime @updatedAt

  images ImagePressOn[]

  @@index([clienteId])
  @@index([statut])
}

// Photos jointes par la cliente à sa commande de press-on.
model ImagePressOn {
  id         String          @id @default(cuid())
  url        String
  commande   CommandePressOn @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId String
  creeLe     DateTime        @default(now())

  @@index([commandeId])
}

// EN_ATTENTE par défaut : Zélia confirme chaque demande à la main
// (et demande un acompte de 15 € aux nouvelles clientes, cf. CGV).
enum StatutRendezVous {
  EN_ATTENTE
  CONFIRME
  ANNULE
  TERMINE
  NO_SHOW
}
