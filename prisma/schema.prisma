generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        String  @id @default(cuid())
  prenom    String
  nom       String
  email     String  @unique
  telephone String
  notes     String? // suivi : allergies, préférences, particularités des ongles…

  // Prospection : consentement recueilli à la réservation, révocable à tout
  // moment via le lien de désinscription (jeton non devinable).
  consentementMarketing Boolean   @default(false)
  consentementLe        DateTime?
  desabonneLe           DateTime?
  jetonDesabonnement    String    @unique @default(cuid())

  // Espace cliente (facultatif) : connexion par lien envoyé par e-mail,
  // sans mot de passe à créer ni à retenir.
  codeParrainage String  @unique
  parraine       Cliente?  @relation("Parrainage", fields: [parraineParId], references: [id])
  parraineParId  String?
  filleules      Cliente[] @relation("Parrainage")

  creeLe     DateTime         @default(now())
  modifieLe  DateTime         @updatedAt
  rendezVous RendezVous[]
  envois      EnvoiCampagne[]
  jetons      JetonConnexion[]
  recompenses Recompense[]
}

// Lot gagné à la roue de fidélité, présenté au salon par la cliente.
model Recompense {
  id        String    @id @default(cuid())
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  lot       LotRoue
  code      String    @unique
  gagneLe   DateTime  @default(now())
  utiliseLe DateTime?

  @@index([clienteId])
}

enum LotRoue {
  POSE_MOINS_50
  PORTE_CLEF
  MOINS_5
  INAKA_10
}

// Lien de connexion à usage unique et à durée limitée.
model JetonConnexion {
  id        String    @id @default(cuid())
  jeton     String    @unique
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  expireLe  DateTime
  utiliseLe DateTime?
  creeLe    DateTime  @default(now())

  @@index([clienteId])
}

// Campagne de fidélisation / parrainage envoyée aux clientes consentantes.
model Campagne {
  id        String          @id @default(cuid())
  objet     String
  contenu   String // texte simple ; {{prenom}} est remplacé à l'envoi
  segment   String // voir src/lib/segments.ts
  statut    StatutCampagne  @default(BROUILLON)
  creeLe    DateTime        @default(now())
  envoyeeLe DateTime?
  envois    EnvoiCampagne[]
}

// Une ligne par destinataire : évite les doublons et garde une trace des échecs.
model EnvoiCampagne {
  id         String   @id @default(cuid())
  campagne   Campagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  campagneId String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  ok         Boolean
  erreur     String?
  envoyeLe   DateTime @default(now())

  @@unique([campagneId, clienteId])
}

enum StatutCampagne {
  BROUILLON
  EN_COURS
  ENVOYEE
}

model Prestation {
  id          String  @id @default(cuid())
  nom         String
  categorie   String // "Vernis semi-permanent", "Gainage", "Pose Gel X", "Pose Pop-it"
  description String?
  dureeMin    Int // durée indicative en minutes
  prixCents   Int // 3500 = 35,00 €
  aPartirDe   Boolean @default(false) // prix "à partir de" (nail art niveau 3…)
  active      Boolean @default(true)
  ordre       Int     @default(0)

  // Nature de l'acte et technique concernée : pilotent les règles de
  // réservation (une dépose ou un remplissage ne se proposent pas à tout le monde).
  typeActe TypeActe @default(POSE)
  typePose TypePose

  lignes LignePrestation[]
}

// Une demande peut porter plusieurs prestations : la cliente en coche autant
// qu'elle souhaite, et la dépose imposée par les règles s'y ajoute (automatique).
model LignePrestation {
  id           String     @id @default(cuid())
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  rendezVousId String
  prestation   Prestation @relation(fields: [prestationId], references: [id])
  prestationId String
  automatique  Boolean    @default(false)
  ordre        Int        @default(0)

  @@unique([rendezVousId, prestationId])
  @@index([rendezVousId])
}

enum TypeActe {
  POSE
  REMPLISSAGE
  DEPOSE
}

enum TypePose {
  VSP
  GAINAGE
  GEL_X
  POP_IT
}

// Ce que la cliente a sur les ongles au moment de venir.
enum EtatOngles {
  NATUREL
  POSE_ZELART
  POSE_EXTERIEURE
}

// Créneaux d'ouverture récurrents : Zélia reçoit du lundi au samedi à 9h ou 14h.
// Une ligne = une fenêtre réservable (un seul rendez-vous par fenêtre).
model Disponibilite {
  id          String @id @default(cuid())
  jourSemaine Int // 1 = lundi … 7 = dimanche (ISO 8601)
  heureDebut  String // "09:00"
  heureFin    String // "12:30"

  @@index([jourSemaine])
}

// Exceptions ponctuelles : congés, jour férié, rendez-vous perso…
model Indisponibilite {
  id    String   @id @default(cuid())
  debut DateTime
  fin   DateTime
  motif String?
}

// Galerie de réalisations affichée sur la page d'accueil
model Photo {
  id      String   @id @default(cuid())
  url     String
  legende String?
  ordre   Int      @default(0)
  creeLe  DateTime @default(now())
}

model RendezVous {
  id           String           @id @default(cuid())
  cliente      Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String
  lignes       LignePrestation[]
  debut        DateTime
  fin          DateTime // figé à la réservation, indépendant des évolutions de la prestation
  statut       StatutRendezVous @default(EN_ATTENTE)
  noteCliente  String?
  inspiration  String? // envies décrites par la cliente
  creeLe       DateTime         @default(now())

  // État des ongles déclaré à la réservation, et dépose ajoutée d'office
  // lorsque les règles l'imposent (pose extérieure, ou Gel X à retirer).
  etatOngles     EtatOngles?
  typePoseActuel TypePose?

  // Case obligatoire : santé, allergies et droit de refus de la prestation
  consentementSante Boolean @default(false)

  // Acompte demandé aux nouvelles clientes (cf. CGV)
  acompteDemandeLe DateTime?
  acompteRegleLe   DateTime?

  inspirations InspirationImage[]

  @@index([debut])
}

// Réglages modifiables par la gérante sans redéploiement (lien d'acompte…).
model Parametre {
  cle       String   @id
  valeur    String
  modifieLe DateTime @updatedAt
}

// Photos d'inspiration jointes par la cliente à sa demande de rendez-vous.
model InspirationImage {
  id           String     @id @default(cuid())
  url          String
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  rendezVousId String
  creeLe       DateTime   @default(now())

  @@index([rendezVousId])
}

// EN_ATTENTE par défaut : Zélia confirme chaque demande à la main
// (et demande un acompte de 15 € aux nouvelles clientes, cf. CGV).
enum StatutRendezVous {
  EN_ATTENTE
  CONFIRME
  ANNULE
  TERMINE
  NO_SHOW
}
