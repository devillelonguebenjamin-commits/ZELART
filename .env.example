# Chaîne de connexion Postgres, ex. postgresql://user:password@localhost:5432/zelart
DATABASE_URL="postgresql://zelart:zelart@localhost:5432/zelart"

# Mot de passe de l'espace gérante (/admin) — obligatoire pour y accéder
ADMIN_PASSWORD=""

# Notifications e-mail (facultatif) — au choix : Brevo (recommandé) ou Resend
# Clé API https://brevo.com (Paramètres → Clés API)
BREVO_API_KEY=""
# ou clé API https://resend.com
RESEND_API_KEY=""
# Adresse qui reçoit les nouvelles demandes de rendez-vous (celle de Zélia)
NOTIFY_EMAIL=""
# Adresse expéditrice : avec Brevo, une adresse validée dans Paramètres → Expéditeurs
EMAIL_FROM=""

# Galerie photos : fourni automatiquement par Vercel (Storage → Blob)
BLOB_READ_WRITE_TOKEN=""
