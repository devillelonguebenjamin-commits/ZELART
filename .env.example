# Chaîne de connexion Postgres, ex. postgresql://user:password@localhost:5432/zelart
DATABASE_URL="postgresql://zelart:zelart@localhost:5432/zelart"

# Mot de passe de l'espace gérante (/admin) — obligatoire pour y accéder
ADMIN_PASSWORD=""

# Notifications e-mail (facultatif) — au choix : Brevo (recommandé) ou Resend
# Clé API https://brevo.com (Paramètres → Clés API)
BREVO_API_KEY=""
# ou clé API https://resend.com
RESEND_API_KEY=""
# Adresse qui reçoit les nouvelles demandes de rendez-vous (celle de Zélia)
NOTIFY_EMAIL=""
# Adresse expéditrice : avec Brevo, une adresse validée dans Paramètres → Expéditeurs
EMAIL_FROM=""

# Paiement SumUp des press-on (facultatif) — sans ces deux valeurs, Zélia colle
# elle-même sur chaque commande un lien créé dans son application SumUp.
# Clé d'API : https://me.sumup.com/settings/api-keys
SUMUP_API_KEY=""
# Code marchand, visible dans le même tableau de bord
SUMUP_MERCHANT_CODE=""

# Hôte exact du stockage d'images (facultatif) — verrouille les URL acceptées
# sur notre seul magasin, de la forme xxxx.public.blob.vercel-storage.com
BLOB_HOSTNAME=""

# Avis Google (facultatif) — clé de l'API Places (New), console Google Cloud.
# L'établissement se connecte ensuite depuis Réglages, sans toucher au code.
GOOGLE_PLACES_API_KEY=""

# Galerie photos : fourni automatiquement par Vercel (Storage → Blob)
BLOB_READ_WRITE_TOKEN=""

# Adresse publique du site, utilisée dans les liens de désinscription.
# Déduite automatiquement sur Vercel ; à renseigner ailleurs.
SITE_URL=""
